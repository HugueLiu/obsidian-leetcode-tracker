{
  "name": "leetcode-tracker",
  "version": "0.1.0",
  "description": "LeetCode 刷题记录追踪（本地 CSV + 自动同步）",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "esbuild test/run.ts --bundle --platform=node --format=cjs --target=node18 --outfile=test/out.cjs && node test/out.cjs"
  },
  "keywords": [
    "leetcode",
    "obsidian"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/sql.js": "^1.4.9",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.0",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
